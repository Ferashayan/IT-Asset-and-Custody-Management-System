# ------------------------------------------------------------------
# Copy to `.env` (used by docker compose) and adjust as needed.
# For running the backend without Docker, copy to backend/.env instead.
# ------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_DB=itam
POSTGRES_USER=itam
POSTGRES_PASSWORD=itam_password
POSTGRES_PORT=5432

# Only needed when running the backend outside Docker
DATABASE_URL=postgres://itam:itam_password@localhost:5432/itam

# --- Backend API ---
PORT=4000
API_PORT=4000
# REQUIRED in production: long random string (min. 16 chars)
#   generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=please-change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*

# Initial admin account (created on first start if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=admin@company.local

# Insert sample departments, staff and assets on first start (true/false)
SEED_DEMO_DATA=true

# --- Web frontend ---
WEB_PORT=8080
# Optional: API base URL baked into the web build (defaults to /api via nginx proxy)
# VITE_API_URL=http://localhost:4000/api
